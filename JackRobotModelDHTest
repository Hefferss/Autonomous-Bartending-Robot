import numpy as np
import swift
from roboticstoolbox import DHLink, DHRobot
from math import pi
from ir_support import CylindricalDHRobotPlot

link1 = DHLink(d=0.375, a=0, alpha=pi/2, qlim=[-pi, pi])
link2 = DHLink(d=0.181, a=0, alpha=-pi/2, qlim=[-127.5*pi/180, 127.5*pi/180])
link3 = DHLink(d=0.290, a=0, alpha=-pi/2, qlim=[-142.5*pi/180, 142.5*pi/180])
link4 = DHLink(d=0.161, a=0, alpha=pi/2, qlim=[-270*pi/180, 270*pi/180])
link5 = DHLink(d=.310, a=0, alpha=-pi/2, qlim=[-121*pi/180, 132.5*pi/180])
link6 = DHLink(d=0.07, a=0, alpha=0, qlim=[-270*pi/180, 270*pi/180])

robot = DHRobot([link1, link2, link3, link4, link5, link6], name='Staubli TX60')
q = np.array([0, 0, 0, 0, 0, 0])

cyl_viz = CylindricalDHRobotPlot(robot, cylinder_radius=0.025, color="#7b1d1d")
robot = cyl_viz.create_cylinders()

env = swift.Swift()
env.launch(realtime=True)
env.add(robot)
robot.q = q
env.step()
input("Enter to continue\n")
